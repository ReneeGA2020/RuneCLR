* text=auto eol=lf

# Experiment controllers and managed inputs are bound by raw SHA-256 hashes.
eng/** -text
benchmarks/** -text
src/** -text
tests/** -text
tools/** -text
samples/** -text
# Unified patches deliberately contain space-only context lines.
*.patch -text -whitespace

# Raw-hash-pinned import: these four files are consumed byte-for-byte by the device host build and by
# the reviewed source pins, so they keep CRLF line endings. Treat CR as a line terminator for the
# whitespace check only; real trailing blanks / blanks at EOF / space-before-tab still fail.
eng/ipad-r2r-native/host/src/RunEntry.cs whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
eng/ipad-r2r-native/host/src/runtime.m whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
eng/ipad-r2r-native/host/tools/build_host.py whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
eng/ipad-r2r-native/host/tools/selftest.py whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
