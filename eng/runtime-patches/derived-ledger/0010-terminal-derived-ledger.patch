     }
 
     bool Enabled() const { return m_enabled; }
@@ -45,6 +51,8 @@ public:
 
     INT64 CleanupExecuted() const noexcept
     {
+        if (m_derivedLedger)
+            return m_initialCleanupLimit - CleanupRemaining();
         return InterlockedCompareExchange64(&m_cleanupExecuted, 0, 0);
     }
 
@@ -57,7 +65,7 @@ public:
         }
         if (IsTerminated())
             return false;
