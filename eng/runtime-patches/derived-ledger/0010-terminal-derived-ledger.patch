         static_assert(offsetof(RuneCLRInstructionMeter, m_enabled) == 0);
         static_assert(offsetof(RuneCLRInstructionMeter, m_terminalPrototype) == 1);
         static_assert(offsetof(RuneCLRInstructionMeter, m_phaseAcquireLoad) == 2);
